{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/server/index.js" },
    { "src": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|map))$", "dest": "/client/dist/$1" },
    { "src": "/(.*)", "dest": "/client/dist/$1" },
    { "src": "/", "dest": "/client/dist/index.html" }
  ]
}
